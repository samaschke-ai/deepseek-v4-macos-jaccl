diff --git a/tests/test-rpc-reconnect.cpp b/tests/test-rpc-reconnect.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-rpc-reconnect.cpp
@@ -0,0 +1,34 @@
+#include "ggml-rpc.h"
+
+#include <chrono>
+#include <cstdio>
+#include <thread>
+
+static size_t query_total(const char * endpoint) {
+    size_t free_mem = 0;
+    size_t total_mem = 0;
+    ggml_backend_rpc_get_device_memory(endpoint, 0, &free_mem, &total_mem);
+    return total_mem;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        return 2;
+    }
+    const char * endpoint = argv[1];
+    const size_t first = query_total(endpoint);
+    std::printf("first_total=%zu\n", first);
+    std::fflush(stdout);
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+    const size_t second = query_total(endpoint);
+    std::printf("second_total=%zu\n", second);
+    std::fflush(stdout);
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+    const size_t third = query_total(endpoint);
+    std::printf("third_total=%zu\n", third);
+    std::fflush(stdout);
+
+    return first > 0 && second == 0 && third > 0 ? 0 : 1;
+}
diff --git a/tests/test-rpc-reconnect.sh b/tests/test-rpc-reconnect.sh
new file mode 100644
--- /dev/null
+++ b/tests/test-rpc-reconnect.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+server=$1
+client=$2
+port=$((45000 + $$ % 10000))
+endpoint="127.0.0.1:${port}"
+test_dir=$(mktemp -d)
+server_pid=""
+client_pid=""
+
+cleanup() {
+    if [[ -n "$client_pid" ]]; then kill "$client_pid" 2>/dev/null || true; fi
+    if [[ -n "$server_pid" ]]; then kill "$server_pid" 2>/dev/null || true; fi
+    rm -rf "$test_dir"
+}
+trap cleanup EXIT
+
+wait_for_port() {
+    local p=$1
+    for _ in {1..600}; do
+        if (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then
+            exec 3>&-
+            exec 3<&-
+            return 0
+        fi
+        sleep 0.05
+    done
+    return 1
+}
+
+wait_for_line() {
+    local file=$1
+    local needle=$2
+    for _ in {1..600}; do
+        if python3 - "$file" "$needle" <<'PY'
+import pathlib
+import sys
+path = pathlib.Path(sys.argv[1])
+needle = sys.argv[2]
+try:
+    present = needle in path.read_text()
+except FileNotFoundError:
+    present = False
+raise SystemExit(0 if present else 1)
+PY
+        then
+            return 0
+        fi
+        sleep 0.05
+    done
+    return 1
+}
+
+start_server() {
+    "$server" --device CPU --host 127.0.0.1 --port "$port" >"$test_dir/server.log" 2>&1 &
+    server_pid=$!
+    wait_for_port "$port"
+}
+
+start_server
+"$client" "$endpoint" >"$test_dir/client.log" 2>&1 &
+client_pid=$!
+wait_for_line "$test_dir/client.log" first_total=
+kill -TERM "$server_pid"
+wait "$server_pid" 2>/dev/null || true
+server_pid=""
+wait_for_line "$test_dir/client.log" second_total=
+start_server
+wait "$client_pid"
+client_pid=""
+
+python3 - "$test_dir/client.log" <<'PY'
+import pathlib
+import sys
+values = {}
+for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
+    key, value = line.split('=', 1)
+    values[key] = int(value)
+if values.get('first_total', 0) <= 0:
+    raise SystemExit('first query did not succeed')
+if values.get('second_total') != 0:
+    raise SystemExit(f"second query unexpectedly succeeded: {values}")
+if values.get('third_total', 0) <= 0:
+    raise SystemExit('reconnect query did not succeed')
+print(values)
+PY
diff --git a/tests/test-server-prefill-fairness.cpp b/tests/test-server-prefill-fairness.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-server-prefill-fairness.cpp
@@ -0,0 +1,50 @@
+#include "../tools/server/server-prefill-budget.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+struct slot { int id; bool pending; int progress; };
+static void require(bool ok, const char * message) {
+    if (!ok) { std::fprintf(stderr, "FAIL %s\n", message); std::exit(1); }
+}
+int main() {
+    const auto pending = [](const slot & s) { return s.pending; };
+    std::vector<slot> slots = {{0, false, 0}, {1, true, 0}, {2, true, 0}, {3, true, 0}};
+    size_t cursor = 0;
+    // A full allowance is consumed by the first long prompt each turn.
+    for (int turn = 0; turn < 99; ++turn) {
+        int available = server_prefill_batch_limit(2048, 1, 1, 256) - 1;
+        for (auto * s : server_prefill_order(slots, cursor, true, pending)) {
+            if (s->pending) { s->progress += available; available = 0; }
+        }
+    }
+    for (size_t i = 1; i < slots.size(); ++i) {
+        require(slots[i].progress > 0, "every pending prefill must progress during active decode");
+        require(slots[i].progress == 33 * 256, "persistent pending slots receive equal turns");
+    }
+    // Disabled policy or no active decode uses the exact original order and cursor.
+    const size_t saved = cursor;
+    for (int budget : {0, 256}) {
+        const int generating = budget == 0 ? 2 : 0;
+        auto order = server_prefill_order(slots, cursor, budget > 0 && generating > 0, pending);
+        require(order.size() == slots.size(), "inactive path retains all slots");
+        for (size_t i = 0; i < slots.size(); ++i) {
+            require(order[i] == &slots[i], "inactive path preserves original slot ordering");
+        }
+        require(cursor == saved, "inactive path preserves cursor");
+    }
+    // A slot replacement and idle gap must not pin a later pending prompt.
+    slots[1].pending = false;
+    slots[2].progress = slots[3].progress = 0;
+    cursor = 1000;
+    for (int turn = 0; turn < 4; ++turn) {
+        auto order = server_prefill_order(slots, cursor, true, pending);
+        require(order.size() == 2, "only pending slots rotate");
+        ++order.front()->progress;
+    }
+    require(slots[2].progress == 2 && slots[3].progress == 2, "idle and reused slots preserve fairness");
+    for (size_t i = 0; i < slots.size(); ++i) { require(slots[i].id == int(i), "slot storage and decode order unchanged"); }
+    slots.clear();
+    require(server_prefill_order(slots, cursor, true, pending).empty(), "empty slot list is safe");
+    std::puts("PASS server-prefill-fairness: per-slot progress, inactive order, reuse, empty slots");
+}
