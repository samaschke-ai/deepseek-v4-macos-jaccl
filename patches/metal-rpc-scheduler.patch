+#include "../tools/server/server-prefill-budget.h"
+#include <cstdio>
+#include <cstdlib>
+
+static void check(int actual, int expected, const char * name) {
+    if (actual != expected) {
+        std::fprintf(stderr, "FAIL %s: got %d, expected %d\n", name, actual, expected);
+        std::exit(1);
+    }
+}
+
+int main() {
+    check(server_prefill_batch_limit(2048, 1, 1, 256), 257, "decode-active cap");
+    check(server_prefill_batch_limit(2048, 2, 2, 256), 130, "two decoders tighten budget");
+    check(server_prefill_batch_limit(2048, 3, 3, 256), 88, "three decoders tighten budget");
+    check(server_prefill_batch_limit(2048, 0, 0, 256), 2048, "prefill-only full throughput");
+    check(server_prefill_batch_limit(2048, 3, 3, 0), 2048, "disabled compatibility");
+    check(server_prefill_batch_limit(2048, 4, 4, 1), 5, "minimum aggregate prefill progress");
+    check(server_prefill_batch_limit(8, 7, 1, 256), 8, "remaining capacity clamp");
+    check(server_prefill_batch_limit(8, 8, 1, 256), 8, "full decode batch cannot admit");
+    check(server_prefill_batch_limit(8, 10, 2, 256), 10, "never discard admitted drafts");
+    check(server_prefill_batch_limit(2048, 30, 3, 256), 115, "draft tokens consume capacity not slots");
+    for (int n = 1; n <= 32; ++n) {
+        for (int d = 0; d <= n; ++d) {
+            for (int g = 1; g <= 4; ++g) {
+                const int limit = server_prefill_batch_limit(n, d, g, 7);
+                if (limit < d || limit > n || (d < n && limit == d)) {
+                    std::fprintf(stderr, "FAIL invariant n=%d d=%d g=%d limit=%d\n", n, d, g, limit);
+                    return 1;
+                }
+            }
+        }
+    }
+    std::puts("PASS server-prefill-budget: examples and exhaustive small-capacity invariants");
+}
