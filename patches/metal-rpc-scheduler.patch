diff --git a/tools/server/server-prefill-budget.h b/tools/server/server-prefill-budget.h
new file mode 100644
index 0000000..8d95a50
--- /dev/null
+++ b/tools/server/server-prefill-budget.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+// Rotate only eligible pending prompts, never the backing slot storage or decode list.
+// The cursor is a stable storage index, so idle/replaced slots cannot pin the order.
+template<class Slot, class Pending>
+inline std::vector<Slot *> server_prefill_order(
+        std::vector<Slot> & slots, size_t & cursor, bool active, Pending pending) {
+    std::vector<Slot *> result;
+    if (!active) {
+        for (auto & slot : slots) { result.push_back(&slot); }
+        return result;
+    }
+    if (slots.empty()) { return result; }
+    const size_t start = cursor % slots.size();
+    for (size_t offset = 0; offset < slots.size(); ++offset) {
+        const size_t index = (start + offset) % slots.size();
+        if (pending(slots[index])) {
+            if (result.empty()) { cursor = (index + 1) % slots.size(); }
+            result.push_back(&slots[index]);
+        }
+    }
+    return result;
+}
+
+// Total admission limit, including already-admitted decode/draft tokens.
+// Zero disables the policy. Never reduce the physical/logical context limits.
+inline int server_prefill_batch_limit(int n_batch, int n_decode_tokens, int n_generating, int budget) {
+    if (budget <= 0 || n_generating <= 0) {
+        return n_batch;
+    }
+    const int available = std::max(0, n_batch - n_decode_tokens);
+    const int allowance = std::min(available, std::max(1, budget / n_generating));
+    return n_decode_tokens + allowance;
+}
